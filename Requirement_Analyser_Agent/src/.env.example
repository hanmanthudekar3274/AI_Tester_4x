# LLM Configuration
LLM_OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

LLM_GROQ_ENABLED=false
GROQ_API_KEY=your_groq_api_key_here
