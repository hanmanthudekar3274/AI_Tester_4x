# Copy to .env and fill in. .env is gitignored and must never be committed.
# Every value can also be set from the Settings screen in the app.
# Values are left EMPTY on purpose: a placeholder would read as "configured"
# to the preflight check and let a run start with a bogus URL.

# --- Jira (Cloud) ---
# JIRA_BASE_URL example: https://acme.atlassian.net
JIRA_BASE_URL=
# JIRA_EMAIL is your Atlassian account email
JIRA_EMAIL=
# Create a token at https://id.atlassian.com/manage-profile/security/api-tokens
# Read scope is sufficient. This app never writes to Jira.
JIRA_API_TOKEN=
# Optional. Set to e.g. QA so that typing "123" resolves to "QA-123".
JIRA_DEFAULT_PROJECT_KEY=
# Leave true. Set false ONLY on a corporate network whose proxy rewrites
# certificates. Disabling this exposes the API token to interception.
JIRA_VERIFY_SSL=true

# --- Groq ---
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.2
# Input and output share one tokens-per-minute budget. Keep max output below
# the TPM limit or Groq rejects the request with a 413 before it runs.
GROQ_MAX_TOKENS=6000
# Your account's Groq tokens-per-minute limit. 8000 is the on-demand tier.
GROQ_TPM_LIMIT=8000

# --- Preferences (non-secret) ---
# Stamped as the plan author. Cosmetic only.
DISPLAY_NAME=
# markdown | docx
DEFAULT_OUTPUT_FORMAT=markdown
